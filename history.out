   52  sudo -1 -U user1
   53  sudo -l -U user1
   54  date
   55  sudo -u user1 sudo /usr/bin/date -s "2026-10-07 10:00:00"
   56  date
   57  sudo -u user1 sudo /usr/bin/date -s "2026-10-07 10:00:00"
   58  date
